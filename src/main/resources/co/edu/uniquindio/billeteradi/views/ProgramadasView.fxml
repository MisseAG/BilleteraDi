<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="content-area"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.billeteradi.controller.ProgramadasController">

    <Label text="Operaciones Programadas" styleClass="page-title"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox styleClass="content-card" prefWidth="340" minWidth="320" spacing="12">
            <Label text="Programar Operacion" styleClass="section-title"/>
            <Separator/>
            <Label text="TIPO DE OPERACION" styleClass="form-label"/>
            <ComboBox fx:id="cmbTipoOp" promptText="Seleccione tipo..." maxWidth="1.7976931348623157E308"/>
            <Label text="BILLETERA ORIGEN" styleClass="form-label"/>
            <ComboBox fx:id="cmbOrigenProg" promptText="Seleccione origen..." maxWidth="1.7976931348623157E308"/>
            <Label text="BILLETERA DESTINO" styleClass="form-label"/>
            <ComboBox fx:id="cmbDestinoProg" promptText="Seleccione destino..." maxWidth="1.7976931348623157E308"/>
            <Label text="IMPORTE" styleClass="form-label"/>
            <TextField fx:id="txtImporteProg" promptText="0.00" styleClass="form-field"/>
            <Label text="FECHA DE EJECUCION" styleClass="form-label"/>
            <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308"/>
            <Label text="HORA (HH:mm)" styleClass="form-label"/>
            <TextField fx:id="txtHora" promptText="14:30" styleClass="form-field"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Programar" onAction="#onProgramar" styleClass="accent-button" maxWidth="1.7976931348623157E308"/>
            <Button text="Procesar Vencidas" onAction="#onProcesarVencidas" styleClass="accent-button" maxWidth="1.7976931348623157E308"/>
            <Button text="Cancelar Seleccionada" onAction="#onCancelar" styleClass="danger-button" maxWidth="1.7976931348623157E308"/>
        </VBox>

        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="Operaciones Registradas" styleClass="section-title"/>
            <TableView fx:id="tblProgramadas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProgId" text="ID" prefWidth="90"/>
                    <TableColumn fx:id="colProgTipo" text="Tipo" prefWidth="110"/>
                    <TableColumn fx:id="colProgImporte" text="Importe" prefWidth="100"/>
                    <TableColumn fx:id="colProgOrigen" text="Origen" prefWidth="90"/>
                    <TableColumn fx:id="colProgDestino" text="Destino" prefWidth="90"/>
                    <TableColumn fx:id="colProgFecha" text="Fecha Ejecucion" prefWidth="150"/>
                    <TableColumn fx:id="colProgEstado" text="Estado" prefWidth="100"/>
                </columns>
                <placeholder><Label text="No hay operaciones programadas" styleClass="page-subtitle"/></placeholder>
            </TableView>
            <HBox styleClass="pagination-bar" alignment="CENTER_RIGHT">
                <Label fx:id="lblRegistrosProg" text="0 registros" styleClass="pagination-info"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>
