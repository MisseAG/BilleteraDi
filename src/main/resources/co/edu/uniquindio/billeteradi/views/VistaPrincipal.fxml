<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.billeteradi.controller.PrincipalController"
            prefWidth="1200" prefHeight="720">
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <padding><Insets top="24" bottom="20"/></padding>

            <Label text="BilleteraDi" styleClass="sidebar-brand"/>
            <Label text="Billetera Digital" styleClass="sidebar-subtitle"/>
            <Region prefHeight="16"/>
            <Separator styleClass="sidebar-separator"/>
            <Region prefHeight="12"/>

            <Label text="GESTIÓN" styleClass="sidebar-section"/>
            <Button fx:id="btnNavUsuarios" text="Usuarios" onAction="#onNavUsuarios"
                    styleClass="sidebar-button" maxWidth="1.7976931348623157E308"/>
            <Button fx:id="btnNavBilleteras" text="Billeteras" onAction="#onNavBilleteras"
                    styleClass="sidebar-button" maxWidth="1.7976931348623157E308"/>
            <Button fx:id="btnNavMovimientos" text="Movimientos" onAction="#onNavMovimientos"
                    styleClass="sidebar-button" maxWidth="1.7976931348623157E308"/>

            <Region prefHeight="12"/>
            <Separator styleClass="sidebar-separator"/>
            <Region prefHeight="12"/>

            <Label text="PLANIFICACIÓN" styleClass="sidebar-section"/>
            <Button fx:id="btnNavProgramadas" text="Programadas" onAction="#onNavProgramadas"
                    styleClass="sidebar-button" maxWidth="1.7976931348623157E308"/>
            <Button fx:id="btnNavReportes" text="Reportes" onAction="#onNavReportes"
                    styleClass="sidebar-button" maxWidth="1.7976931348623157E308"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="sidebar-separator"/>
            <Region prefHeight="8"/>
            <Label text="v1.0  Hito 4" styleClass="sidebar-subtitle"/>
        </VBox>
    </left>
    <top>
        <HBox styleClass="top-bar" spacing="14" alignment="CENTER_LEFT">
            <Label text="Usuario activo:" styleClass="top-bar-label"/>
            <ComboBox fx:id="cmbUsuarioActivo" onAction="#onUsuarioSeleccionado"
                      prefWidth="260" styleClass="combo-box"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstado" styleClass="badge-active"/>
            <Label text="|" styleClass="top-bar-divider"/>
            <Label fx:id="lblNivel" styleClass="badge-nivel"/>
            <Label text="|" styleClass="top-bar-divider"/>
            <Label fx:id="lblPuntos" styleClass="badge-puntos"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #F4F6F8;">
            <fx:include fx:id="usuariosView" source="UsuariosView.fxml"/>
            <fx:include fx:id="billeterasView" source="BilleterasView.fxml"/>
            <fx:include fx:id="movimientosView" source="MovimientosView.fxml"/>
            <fx:include fx:id="programadasView" source="ProgramadasView.fxml"/>
            <fx:include fx:id="reportesView" source="ReportesView.fxml"/>
        </StackPane>
    </center>
</BorderPane>
